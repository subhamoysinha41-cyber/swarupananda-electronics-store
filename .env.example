# Local MongoDB connection (docker compose exposes localhost:27017)
DATABASE_URL=mongodb://localhost:27017/mobile-store

# Local development only; provide a long, unique secret outside Development.
NODE_ENV=development
JWT_SECRET=
JWT_ISSUER=mobile-store-api
JWT_AUDIENCE=mobile-store-web
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173

# Optional external integrations. Checkout/upload APIs return a service error until configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional Azure Blob enhancement; local emulator connection for explicit Development only.
AZURE_FUNCTIONS_ENVIRONMENT=Development
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=mobile-store
AZURITE_BLOB_CONNECTION_STRING=UseDevelopmentStorage=true

# Frontend Vite API origin (can be blank when the frontend uses its /api proxy)
VITE_API_BASE_URL=
