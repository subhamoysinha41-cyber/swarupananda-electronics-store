{
  "name": "mobile-store",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --prefix services/mobile-store-api run build",
    "build:web": "npm --prefix services/mobile-store-web run build",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm --prefix services/mobile-store-api test",
    "test:web": "npm --prefix services/mobile-store-web test",
    "dev:api": "npm --prefix services/mobile-store-api run dev",
    "dev:web": "npm --prefix services/mobile-store-web run dev"
  }
}
